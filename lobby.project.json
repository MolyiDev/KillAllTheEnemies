{
    "name": "Lobby",
    // Rojo serves only into the new Lobby place. The OLD Lobby place is 105859632802526: kept only to read its
    // code and instances with Tripwire (pick it by placeId in list_studios), never to serve into.
    "servePlaceIds": [
        97384805316642
    ],
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json",
        // Offline renders (ror / ree / rur) sit beside their kit's sources; their recordings are not game models.
        "Assets/**/preview",
        "Assets/**/preview/**"
    ],
    "tree": {
        "$className": "DataModel",
        "Workspace": {
            "$className": "Workspace",
            "$ignoreUnknownInstances": true,
            "Characters": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            },
            "Temporal": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            }
        },
        // The old Lobby place's lighting, which this map was built under: a sun straight overhead over a deep-space
        // sky (the two Sky instances are in the place, not here), full ambient indoors, a strong bloom on the neon.
        "Lighting": {
            "$className": "Lighting",
            "$ignoreUnknownInstances": true,
            "$properties": {
                "Ambient": [
                    0.980392,
                    0.980392,
                    0.980392
                ],
                "Brightness": 1,
                "ClockTime": 12,
                "GeographicLatitude": 0,
                "ColorShift_Bottom": [
                    0,
                    0,
                    0
                ],
                "ColorShift_Top": [
                    0,
                    0,
                    0
                ],
                "EnvironmentDiffuseScale": 1,
                "EnvironmentSpecularScale": 1,
                "GlobalShadows": true,
                "ShadowSoftness": 0.15,
                "LightingStyle": "Realistic",
                "OutdoorAmbient": [
                    0.039216,
                    0.027451,
                    0.133333
                ],
                "PrioritizeLightingQuality": true,
                "ExposureCompensation": 0
            },
            "Atmosphere": {
                "$className": "Atmosphere",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Density": 0.3,
                    "Offset": 0.25,
                    "Color": [
                        0.780392,
                        0.780392,
                        0.780392
                    ],
                    "Decay": [
                        0.415686,
                        0.439216,
                        0.490196
                    ],
                    "Glare": 0,
                    "Haze": 0
                }
            },
            "Bloom": {
                "$className": "BloomEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Enabled": true,
                    "Intensity": 1,
                    "Size": 24,
                    "Threshold": 2
                }
            },
            // Zero at rest: the world blur behind screens drives it.
            "Blur": {
                "$className": "BlurEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Size": 0
                }
            },
            // The old place had neither of these two: kept with their values, switched off.
            "ColorCorrection": {
                "$className": "ColorCorrectionEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Brightness": 0.15,
                    "Contrast": 0.15,
                    "Enabled": false,
                    "Saturation": 0.85,
                    "TintColor": [
                        1,
                        1,
                        1
                    ]
                }
            },
            "ColorGrading": {
                "$className": "ColorGradingEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Enabled": false,
                    "TonemapperPreset": "Retro"
                }
            },
            "DepthOfField": {
                "$className": "DepthOfFieldEffect",
                "$ignoreUnknownInstances": true
            },
            "SunRays": {
                "$className": "SunRaysEffect",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Enabled": true,
                    "Intensity": 0.25,
                    "Spread": 1
                }
            }
        },
        "ReplicatedFirst": {
            "$className": "ReplicatedFirst",
            "$ignoreUnknownInstances": true,
            "GlobalFirstShared": {
                "$path": "src/Global/FirstShared"
            },
            "FirstShared": {
                "$path": "src/Lobby/FirstShared"
            }
        },
        "ReplicatedStorage": {
            "$ignoreUnknownInstances": true,
            "Animations": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true
            },
            "Packages": {
                "$path": "Packages"
            },
            "Shared": {
                "$path": "src/Lobby/Shared"
            },
            "GlobalShared": {
                "$path": "src/Global/Shared"
            },
            "Data": {
                "$path": "src/Global/Data"
            },
            "Types": {
                "$path": "src/Global/Types"
            },
            "Sounds": {
                "$path": "sounds/Sounds.rbxmx"
            },
            "Models": {
                "$className": "Folder",
                "$ignoreUnknownInstances": true,
                // The abilities' models, for the classes screen's ability cards (as the Game place's, which says where
                // they are made). Rojo's too.
                "Abilities": {
                    "$path": "Assets/models/Abilities/ability_models.rbxmx"
                },
                // The equipment's accessories, worn on every avatar and drawn on the equipment screen
                // (Assets/models/Equipment/make_equipment_models.luau). Rojo's too.
                "Equipment": {
                    "$path": "Assets/models/Equipment/equipment_models.rbxmx"
                },
                // The guns, for the weapons screen's cards and stage (as the Game place's, which says where they are
                // made). Rojo's too.
                "Guns": {
                    "$path": "Assets/models/Guns"
                }
            }
        },
        "ServerScriptService": {
            "$ignoreUnknownInstances": true,
            "GlobalServer": {
                "$path": "src/Global/Server"
            },
            "Server": {
                "$path": "src/Lobby/Server"
            }
        },
        "StarterGui": {
            "$className": "StarterGui",
            "$ignoreUnknownInstances": true,
            "$properties": {
                "ScreenOrientation": "LandscapeSensor",
                "VirtualCursorMode": "Disabled"
            }
        },
        "StarterPlayer": {
            "$properties": {
                "EnableMouseLockOption": false,
                "CreateDefaultPlayerModule": false,
                "CharacterWalkSpeed": 33
            },
            // No Animate here: Roblox's default one animates the R6 body with Roblox's own clips (they play in any game).
            "StarterCharacterScripts": {
                "$ignoreUnknownInstances": true
            },
            "StarterPlayerScripts": {
                "$ignoreUnknownInstances": true,
                "GlobalClient": {
                    "$path": "src/Global/Client"
                },
                "Client": {
                    "$path": "src/Lobby/Client"
                },
                "RbxCharacterSounds": {
                    "$className": "LocalScript",
                    "$ignoreUnknownInstances": false,
                    "$properties": {
                        "Enabled": false
                    },
                    "AtomicBinding": {
                        "$className": "LocalScript",
                        "$ignoreUnknownInstances": false
                    }
                },
                "PlayerModule": {
                    "$path": "src/PlayerModule",
                    "$ignoreUnknownInstances": false
                },
                "PlayerScriptsLoader": {
                    "$path": "src/PlayerScriptsLoader.client.luau"
                }
            }
        },
        "SoundService": {
            "$className": "SoundService",
            "$ignoreUnknownInstances": true,
            "Effects": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Volume": 0.5
                }
            },
            "Music": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Volume": 0.5
                }
            },
            "UI": {
                "$className": "SoundGroup",
                "$ignoreUnknownInstances": true,
                "$properties": {
                    "Volume": 0.5
                }
            }
        },
        "Players": {
            "$className": "Players",
            "$ignoreUnknownInstances": true,
            "$properties": {
                "CharacterAutoLoads": false
            }
        }
    }
}
