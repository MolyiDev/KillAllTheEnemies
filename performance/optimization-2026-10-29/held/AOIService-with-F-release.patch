+-- Sends enemy positions to every player who has them subscribed and in view.
+-- `instanceIds` / `positions` are aligned and may be reused by the caller right after.
+function AOIService.SendPositions(instanceIds: { number }, positions: { vector })
+	if #instanceIds == 0 then return end
+	if not MERGE_SENDS then
+		sendNow(instanceIds, positions)
+		return
+	end
+	local n = #pendingIds
+	table.move(instanceIds, 1, #instanceIds, n + 1, pendingIds)
+	table.move(positions, 1, #positions, n + 1, pendingPositions)
+end
+
+RunService.Heartbeat:Connect(function()
+	if #pendingIds == 0 then return end
+	sendNow(pendingIds, pendingPositions)
+	table.clear(pendingIds)
+	table.clear(pendingPositions)
+end)
+
+-- Releases enemies the player hasn't been sent in RELEASE_TIME (outside their view),
+-- telling the client to drop them. They re-subscribe through Tick on re-entering view.
+local function releaseOffscreen(player: Player, state: TPlayerAOIState, now: number)
+	local sentAt, seenAt = state.sentAt, state.seenAt
+	for instanceId in state.knownEnemies do
+		local sent = sentAt[instanceId]
+		if sent and now - sent < RELEASE_TIME then continue end
+		local seen = seenAt[instanceId]
+		if seen and now - seen < RELEASE_TIME then continue end
+		local entity = EnemyWorldRef:Search(instanceId)
+		local pos = if entity then EnemyWorld:get(entity, Components.Position) :: vector? else nil
+		if pos then
+			local dx = pos.x - state.camX
+			local dz = pos.z - state.camZ
+			if dx * dx + dz * dz <= KEEP_DISTANCE_SQ then
+				seenAt[instanceId] = now
+				continue
+			end
+		end
+		forget(state, instanceId)
+		local subs = enemySubscribers[instanceId]
+		if subs then subs[player] = nil end
+		ServerNetworkEnemies.Removed.Fire(player, instanceId)
+	end
+end
