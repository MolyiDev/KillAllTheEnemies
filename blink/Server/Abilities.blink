import "../Types/CharacterInstanceId.blink"
import "../Types/EnemyInstanceId.blink"
import "../Types/DataId.blink"
import "../Types/Vec.blink"

-- Classes and their abilities (Game/Server/Services/AbilityService).

-- To the owner: the class they play this run, its slots' levels (the ultimate last), the casts each slot has paid for
-- this run (its price) and their ultimate's meter, on every spawn, every paid cast and every time the meter moves.
-- (classId, levels, casts, kills banked)
event State {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (DataId.Type, u8[], u16[], u16)
}

-- To the buyer: CHARGE NOW was bought. Fired just before the State that fills the meter, for the show of it filling.
-- (kills banked before it)
event UltimateBought {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: u16
}

-- A decoy was thrown, to everybody. (decoy, thrower, the floor it lands on, seconds in the air, seconds it stands)
event DecoyThrown {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (u8, CharacterInstanceId.Type, Vec.Type, f32, f32)
}

-- An enemy's blow landed on a decoy: it squeaks. (decoy)
event DecoyHit {
	from: Server,
	type: Unreliable,
	call: SingleAsync,
	data: u8
}

-- The decoy is gone: popped by blows, by its time, or by its thrower's next one. (decoy)
event DecoyPopped {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: u8
}

-- To everybody but the caster, who drew their own: a spray of foam. (caster, aim point)
event FoamSprayed {
	from: Server,
	type: Unreliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type, Vec.Type)
}

-- The bodies a spray set, to everybody (a client ignores the ones it was never shown). (enemies, seconds)
event Foamed {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (EnemyInstanceId.Type[], f32)
}

-- An orbital cannon was called, to everybody. (caster, the mark on the floor, seconds until the beam lands, seconds
-- it then burns)
event OrbitalCalled {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type, Vec.Type, f32, f32)
}

-- Where the mark or the beam is now, a few times a second. (caster, floor point)
event OrbitalMoved {
	from: Server,
	type: Unreliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type, Vec.Type)
}

-- The beam is over: it ran its time, or its caster went down. (caster)
event OrbitalEnded {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: CharacterInstanceId.Type
}
