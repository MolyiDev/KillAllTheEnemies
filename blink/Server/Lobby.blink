-- The queue pads (Lobby/Server/Services/LobbyService). Fired to everybody: every player sees every pad.
-- (pad, phase (PadsCore.EPhase), playersOnIt, maxPlayers, map (MapsCore.LIST), difficulty (MapsCore.DIFFICULTIES),
-- isFriendsOnly, hostUserId, secondsLeft). hostUserId 0 is no host; secondsLeft < 0 is no countdown running. While
-- the host is choosing, secondsLeft is his time left to pick (PadsCore.CHOOSE_SECONDS).
event PadState {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (u8, u8, u8, u8, u8, u8, boolean, f64, f32)
}

-- You are on this pad now (0 is no pad), so the client shows Leave, and the host's menu while it is his to pick.
event PadJoined {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (u8)
}

-- To one player whose step onto a pad, or Play, was refused. (pad, reason (PadsCore.ERefusal))
event PadRefused {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (u8, u8)
}

-- To one player: the party on this pad invites them. (pad, inviter's userId, seconds it stands)
event Invited {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (u8, f64, f32)
}

-- To the player who sent an invite: what came of it. (invited userId, result (PadsCore.EInvite))
event InviteAnswered {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (f64, u8)
}

-- One map's part of MapRecords: the best completed round on it, how many times its boss has fallen with this player
-- in the run (TProfile.BossKills), and whether the party screen has played its unlock (TProfile.MapsShown).
struct MapRecord {
	Best: u16,
	BossKills: u16,
	IsShown: boolean,
}

-- To one player: each map's record, in MapsCore.LIST order, so the menu can show which maps are open, what the rest
-- need, and which unlock is still to play. The level they also need comes with Profile.Sync.
event MapRecords {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: MapRecord[]
}
