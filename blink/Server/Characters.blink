import "../Types/CharacterInstanceId.blink"
import "../Types/Player.blink"

-- A character was given its network id. Every client answers CharacterReady, and only once all of them have
-- does the server register it (CharacterService), so no id goes out on another event before clients know it.
event Added {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (Player.Type, CharacterInstanceId.Type)
}

event Removed {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type)
}

-- (character, currentHealth, maxHealth)
event Health {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type, f32, f32)
}

-- (player, the HEALTH levels they hold this run). Sent on each level bought, to everyone: the buyer's HUD shows it
-- and every client draws it on the buyer's body. 0 is a new run taking the levels back.
event HealthLevel {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (Player.Type, u8)
}

-- `player` is about to be revived: their new body stands where the old one fell and every client builds it from the
-- pile of bricks it left (reviveFx). Sent before the body is loaded; a body that comes without it (a run started
-- over) is a fresh one.
event Revived {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: Player.Type
}
