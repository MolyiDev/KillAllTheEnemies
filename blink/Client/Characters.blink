import "../Types/CharacterInstanceId.blink"
import "../Types/Player.blink"

event CharacterReady {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (CharacterInstanceId.Type)
}

-- Buy the next HEALTH level (Shared/Utils/healthUpgrades). Only the intent: the level, its price and the Gold are the
-- server's.
event UpgradeHealth {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: ()
}

-- Buy a downed player's revive during a run (EProducts.QuickRevive): the buyer's own, or a squadmate's. Only the pick:
-- the server checks it (that player down in a running match), keeps it and prompts the product.
event Revive {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: Player.Type
}
