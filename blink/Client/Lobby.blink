-- Step off the pad you are queued on. Stepping out of its zone does the same without this.
event LeavePad {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: ()
}

-- I just stepped into this pad's zone, so put me on it now rather than when the zone poll finds me. (pad)
event StepOnPad {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (u8)
}

-- The Play button: put me on a free pad as its host, or into an open party if none is free.
event Play {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: ()
}

-- The host's party, once picked. Only the host of a pad still being chosen is heard.
-- (maxPlayers, map (MapsCore.LIST), difficulty (MapsCore.DIFFICULTIES), isFriendsOnly)
event StartParty {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (u8, u8, u8, boolean)
}

-- Invite a player in this server to the party on my pad. (userId)
event InvitePlayer {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: f64
}

-- My answer to a party's invite: join it (true) or turn it down. (pad, isJoining)
event AnswerInvite {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (u8, boolean)
}

-- The party screen has played this map's unlock, so it is never played again. (map (MapsCore.LIST))
event MapShown {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: u8
}
